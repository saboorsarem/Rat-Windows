<Window x:Class="Rat.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rules" Width="820" Height="480" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
            <Button x:Name="btnAdd" Content="Add"/>
            <Button x:Name="btnDelete" Content="Delete" Margin="6,0,0,0"/>
            <Button x:Name="btnExport" Content="Export JSON" Margin="6,0,0,0"/>
            <Button x:Name="btnImport" Content="Import JSON" Margin="6,0,0,0"/>
        </StackPanel>
        <DataGrid x:Name="grid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="8"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="App" Binding="{Binding AppDisplay}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="1.2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Port" Binding="{Binding PortDisplay}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Lifetime" Binding="{Binding Lifetime}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
