<Window x:Class="Rat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rat - network monitor"
        Height="690" Width="1100" MinHeight="420" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Accent}">
                        <TextBlock Text="R" FontSize="16" FontWeight="Bold" Foreground="#0F1115"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Rat" Style="{StaticResource Title}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="outbound connections" Style="{StaticResource MutedText}"
                               Margin="9,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="chkAlert" Content="Ask before new connections"
                              Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Button x:Name="btnRules" Content="Rules" MinWidth="72"/>
                    <TextBlock x:Name="tbThroughput" Style="{StaticResource MutedText}"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
            <TextBlock x:Name="tbStatus" Style="{StaticResource MutedText}" Text="Monitoring..."/>
        </Border>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="gridApps">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Connections" Binding="{Binding Connections}" Width="90"/>
                    <DataGridTextColumn Header="Servers" Binding="{Binding Servers}" Width="2.4*"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"/>
            <DataGrid x:Name="gridConns" Grid.Column="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Server" Binding="{Binding Remote}" Width="120"/>
                    <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="2*"/>
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60"/>
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                    <DataGridTextColumn Header="Since" Binding="{Binding Since}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
