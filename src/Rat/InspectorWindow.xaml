<Window x:Class="Rat.InspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rat - inspector"
        Height="430" Width="760" MinHeight="280" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app.ico">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="tbTitle" Style="{StaticResource Title}"/>
                <TextBlock x:Name="tbSub" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="grid" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Server" Binding="{Binding Remote}" Width="130"/>
                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="2*"/>
                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                <DataGridTextColumn Header="Since" Binding="{Binding Since}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
