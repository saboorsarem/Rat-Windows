<Window x:Class="Rat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rat - network monitor"
        Height="640" Width="1040" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
            <TextBlock Text="Rat" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <CheckBox x:Name="chkAlert" Content="Ask before new connections" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button x:Name="btnRules" Content="Rules" Margin="0,0,8,0"/>
            <TextBlock x:Name="tbThroughput" VerticalAlignment="Center" Foreground="Gray" Margin="16,0,0,0"/>
        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="tbStatus" Text="Monitoring"/>
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="gridApps" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" SelectionMode="Single" Margin="6"
                      GridLinesVisibility="Horizontal" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Connections" Binding="{Binding Connections}" Width="90"/>
                    <DataGridTextColumn Header="Servers" Binding="{Binding Servers}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="LightGray"/>
            <DataGrid x:Name="gridConns" Grid.Column="2" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" Margin="6" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Server" Binding="{Binding Remote}" Width="120"/>
                    <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="2*"/>
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60"/>
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                    <DataGridTextColumn Header="Since" Binding="{Binding Since}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
