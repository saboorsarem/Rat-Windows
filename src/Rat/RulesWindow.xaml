<Window x:Class="Rat.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rules" Width="880" Height="520" MinHeight="320" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        Icon="pack://application:,,,/app.ico">
    <DockPanel Background="{StaticResource Bg}">
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnAdd" Content="Add rule"/>
                <Button x:Name="btnDelete" Content="Delete" Margin="8,0,0,0"/>
                <Button x:Name="btnExport" Content="Export JSON" Margin="8,0,0,0"/>
                <Button x:Name="btnImport" Content="Import JSON" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="grid" Margin="10" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="App" Binding="{Binding AppDisplay}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="1.2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Port" Binding="{Binding PortDisplay}" Width="55" IsReadOnly="True"/>
                <DataGridTextColumn Header="Lifetime" Binding="{Binding Lifetime}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
