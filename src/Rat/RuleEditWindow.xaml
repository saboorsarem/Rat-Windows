<Window x:Class="Rat.RuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add rule" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="App path" VerticalAlignment="Center"/>
        <TextBox x:Name="tbApp" Grid.Column="1" Margin="0,2"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="empty = any app" Foreground="Gray" FontSize="11"/>
        <TextBlock Grid.Row="2" Text="Server" VerticalAlignment="Center"/>
        <TextBox x:Name="tbServer" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="ip or hostname, empty = any server" Foreground="Gray" FontSize="11"/>
        <TextBlock Grid.Row="4" Text="Port" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
            <TextBox x:Name="tbPort" Width="60" Margin="0,2"/>
            <ComboBox x:Name="cmbAction" Width="80" Margin="12,0,0,0"/>
            <ComboBox x:Name="cmbLife" Width="100" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnOk" Content="OK" Width="80" IsDefault="True" Margin="0,0,8,0"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
